# Optional API startup source-handle warmup; default off (1 or true enables it).
# No searches, embeddings, model calls or personal-data cache. Startup waits at most 5s.
# ~2.5s observed initialization work is not a proven per-request saving or p95 gain.
# Historical R1 benchmarks were prewarm-off; this switch does not change answer flags.
NESTLING_PREWARM_SOURCES=false
